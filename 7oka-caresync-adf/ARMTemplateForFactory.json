						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": {
										"value": "update ctrl.audit_log\nSET STATUS = 'Success', end_time= sysutcdatetime(), records_written = @{activity('bronze2silver').output.runOutput}\nwhere adf_run_id = '@{pipeline().parameters.adf_iterator}' and table_id  = @{pipeline().parameters.table_id};",
										"type": "Expression"
									}
								}
