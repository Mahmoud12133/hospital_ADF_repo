													"type": "DatasetReference",
													"parameters": {
														"container": "container",
														"folder": {
															"value": "@concat(\n    activity('read table details from table config').output.firstRow.source_system,\n    '/',\n    activity('read table details from table config').output.firstRow.source_table_name,\n    '/',\n    variables('start_time')\n)",
															"type": "Expression"
														}
													}
												}
											]
										}
									]
								},
